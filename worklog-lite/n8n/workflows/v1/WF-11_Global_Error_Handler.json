{
  "name": "WF-11 Global Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## WF-11 Global Error Handler\n**Purpose**: set as the Error Workflow on every WorkLog Lite workflow (build-prompt S9). Appends failures to an `Ops Errors` tab and throttles alerts to at most one per workflow per 10 minutes. Never logs user message text.\n\n**Input**: n8n Error Trigger payload (`$json.execution`, `$json.workflow`).",
        "height": 300,
        "width": 400
      },
      "id": "sticky_purpose",
      "name": "Purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        40
      ]
    },
    {
      "parameters": {},
      "id": "trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst execution = input.execution || {};\nconst workflow = input.workflow || {};\n\nreturn [{\n  json: {\n    Timestamp: new Date().toISOString(),\n    Workflow: workflow.name || 'unknown',\n    Node: execution.lastNodeExecuted || 'unknown',\n    Message: (execution.error && execution.error.message) || input.message || 'unknown error',\n    'Execution URL': execution.url || ''\n  }\n}];"
      },
      "id": "build_error_row",
      "name": "Build Error Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        400
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Ops Errors",
          "mode": "list",
          "cachedResultName": "Ops Errors"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.Timestamp }}",
            "Workflow": "={{ $json.Workflow }}",
            "Node": "={{ $json.Node }}",
            "Message": "={{ $json.Message }}",
            "Execution URL": "={{ $json['Execution URL'] }}"
          }
        },
        "options": {},
        "authentication": "serviceAccount"
      },
      "id": "append_ops_error",
      "name": "Append Ops Error",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        540,
        400
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "googleApi": {
          "id": "worklog_sheets",
          "name": "WorkLog Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst row = $json;\nconst workflowName = row.Workflow;\nconst now = Date.now();\nconst TEN_MIN = 10 * 60 * 1000;\n\nstaticData.lastAlertAt = staticData.lastAlertAt || {};\nconst last = staticData.lastAlertAt[workflowName] || 0;\nconst shouldAlert = (now - last) > TEN_MIN;\n\nif (shouldAlert) staticData.lastAlertAt[workflowName] = now;\n\nreturn [{ json: { ...row, should_alert: shouldAlert } }];"
      },
      "id": "throttle_check",
      "name": "Throttle Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.should_alert }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "should_alert_if",
      "name": "Should alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        980,
        400
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $vars.WORKLOG_OPS_FROM_EMAIL || \"REPLACE_WITH_OPS_FROM_EMAIL\" }}",
        "toEmail": "={{ $vars.WORKLOG_OPS_ALERT_EMAIL || \"REPLACE_WITH_OPS_EMAIL\" }}",
        "subject": "=WorkLog Lite error: {{ $json.Workflow }}",
        "message": "=Node: {{ $json.Node }}\\nMessage: {{ $json.Message }}\\nExecution: {{ $json['Execution URL'] }}\\n\\n(Throttled to at most one alert per workflow per 10 minutes.)",
        "options": {}
      },
      "id": "send_alert_email",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        320
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "worklog_ops_smtp",
          "name": "WorkLog Ops SMTP"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build Error Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Error Row": {
      "main": [
        [
          {
            "node": "Append Ops Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Ops Error": {
      "main": [
        [
          {
            "node": "Throttle Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Throttle Check": {
      "main": [
        [
          {
            "node": "Should alert?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should alert?": {
      "main": [
        [
          {
            "node": "Send Alert Email",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "id": "WF-11_Global_Error_Handler",
  "active": true
}
