{
  "name": "WF-13 PIN Enrolment",
  "nodes": [
    {
      "parameters": {
        "content": "## WF-13 PIN Enrolment\n**Purpose**: HR form for setting or resetting an employee's WorkLog PIN.\n- Form fields: Employee Code, New PIN (6 digits), Confirm PIN.\n- Validates weak PINs, hashes via peppered HMAC-SHA256, updates `Employees` tab.\n- Execution logs disabled (`saveExecutionProgress: false`).",
        "height": 260,
        "width": 380
      },
      "id": "sticky_purpose",
      "name": "Purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        40
      ]
    },
    {
      "parameters": {
        "formTitle": "WorkLog AI \u2014 PIN Enrolment",
        "formDescription": "HR utility to set or reset an employee's 6-digit WorkLog PIN.",
        "fields": {
          "values": [
            {
              "fieldLabel": "Employee Code",
              "requiredField": true
            },
            {
              "fieldLabel": "New PIN (6 digits)",
              "fieldType": "password",
              "requiredField": true
            },
            {
              "fieldLabel": "Confirm PIN",
              "fieldType": "password",
              "requiredField": true
            }
          ]
        },
        "options": {},
        "path": "pin-enrolment"
      },
      "id": "form_trigger",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [
        100,
        360
      ],
      "webhookId": "pin-enrolment"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst input = $input.first().json;\nconst codeRaw = (input['Employee Code'] || input.employee_code || '').toString();\nconst pinRaw = (input['New PIN (6 digits)'] || input.new_pin || '').toString().trim();\nconst confirmRaw = (input['Confirm PIN'] || input.confirm_pin || '').toString().trim();\n\nconst employeeCode = codeRaw.trim().toUpperCase().replace(/\\s+/g, '');\n\nif (!employeeCode) {\n  return [{ json: { ok: false, message: 'Employee Code is required.' } }];\n}\n\nif (pinRaw !== confirmRaw) {\n  return [{ json: { ok: false, message: 'New PIN and Confirm PIN do not match.' } }];\n}\n\nif (!/^\\d{6}$/.test(pinRaw)) {\n  return [{ json: { ok: false, message: 'PIN must be exactly 6 digits.' } }];\n}\n\n// Reject weak PINs: all same digit, sequential, or contains employee code digits\nif (/^(\\d)\\1{5}$/.test(pinRaw) || pinRaw === '123456' || pinRaw === '654321') {\n  return [{ json: { ok: false, message: 'That PIN is too easy to guess. Please choose a different 6-digit PIN.' } }];\n}\n\nconst codeDigits = employeeCode.replace(/\\D/g, '');\nif (codeDigits.length >= 4 && pinRaw.includes(codeDigits)) {\n  return [{ json: { ok: false, message: 'PIN must not contain your Employee Code digits.' } }];\n}\n\nconst pepper = process.env.APP_PIN_PEPPER || $vars.WORKLOG_PEPPER || 'default_worklog_pepper_secret_hex';\nconst pinHash = crypto.createHmac('sha256', pepper).update(pinRaw).digest('hex');\n\nreturn [{\n  json: {\n    ok: true,\n    employee_code: employeeCode,\n    pin_hash: pinHash,\n    set_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "validate_and_hash",
      "name": "Validate & Hash PIN",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is_valid",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        540,
        360
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Employees",
          "mode": "list",
          "cachedResultName": "Employees"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Employee Code",
              "lookupValue": "={{ $json.employee_code }}"
            }
          ]
        },
        "options": {
          "returnAllMatches": "returnFirstMatch"
        },
        "authentication": "serviceAccount"
      },
      "id": "lookup_employee",
      "name": "Lookup Employee",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        760,
        280
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleApi": {
          "id": "worklog_sheets",
          "name": "WorkLog Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst row = rows.length && rows[0].json && rows[0].json['Employee Code'] ? rows[0].json : null;\nconst input = $('Validate & Hash PIN').first().json;\n\nif (!row) {\n  return [{ json: { ok: false, message: `Employee Code ${input.employee_code} was not found.` } }];\n}\n\nif ((row.Status || '').toString().trim().toUpperCase() !== 'ACTIVE') {\n  return [{ json: { ok: false, message: `Employee Code ${input.employee_code} is INACTIVE.` } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    employee_code: input.employee_code,\n    pin_hash: input.pin_hash,\n    set_at: input.set_at\n  }\n}];"
      },
      "id": "check_employee_active",
      "name": "Check Employee Active",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        280
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
