    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = Date.now();\n\nconst expired = rows.filter(r => {\n  const exp = r['Expires At'] ? new Date(r['Expires At']).getTime() : null;\n  const hasState = (r.State || '').toString().trim() !== '' && r.State !== '{}';\n  return exp && exp < now && hasState;\n});\n\nreturn expired.map(r => ({\n  json: {\n    'Session ID': r['Session ID'],\n    'Employee Code': r['Employee Code'] || '',\n    State: '{}',\n    Stage: 'IDLE',\n    'Updated At': new Date().toISOString(),\n    'Expires At': r['Expires At']\n  }\n}));"
      },
      "id": "find_expired",
      "name": "Find Expired Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        420
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
