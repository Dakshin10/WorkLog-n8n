    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst now = Date.now();\nconst SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;\n\nreturn rows.filter(i => {\n  const updated = i.json['Updated At'] ? new Date(i.json['Updated At']).getTime() : 0;\n  return updated && (now - updated) > SEVEN_DAYS;\n}).map(i => ({ json: { row_number: i.json.row_number } }));"
      },
