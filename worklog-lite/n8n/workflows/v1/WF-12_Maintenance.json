        "toEmail": "={{ $vars.WORKLOG_HR_DIGEST_EMAIL || \"REPLACE_WITH_HR_EMAIL\" }}",
        "subject": "=WorkLog Lite daily digest \u2014 {{ $now.format('yyyy-MM-dd') }}",
        "message": "={{ $json.digest_text }}",
        "options": {}
      },
      "id": "send_hr_digest",
      "name": "Send HR Digest",
