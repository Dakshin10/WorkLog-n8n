{
  "name": "WF-12 Maintenance",
  "nodes": [
    {
      "parameters": {
        "content": "## WF-12 Maintenance\n**Purpose**: Housekeeping tasks (build-prompt S9):\n1. Every 15 min \u2014 expire idle `Sessions` rows and clear expired `Locked Until` on `Employees`.\n2. Nightly 01:30 \u2014 delete old Sessions (>7 days), archive Audit (>90 days), alert if `Timesheet` passes 40,000 rows.\n3. Weekdays 18:30 \u2014 optional HR summary digest email.",
        "height": 340,
        "width": 440
      },
      "id": "sticky_purpose",
      "name": "Purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
