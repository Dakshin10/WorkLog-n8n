    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst now = Date.now();\nconst NINETY_DAYS = 90 * 24 * 60 * 60 * 1000;\n\nconst old = rows.filter(i => {\n  const ts = i.json.Timestamp ? new Date(i.json.Timestamp).getTime() : 0;\n  return ts && (now - ts) > NINETY_DAYS;\n});\n\nreturn old.map(i => ({ json: i.json }));"
      },
