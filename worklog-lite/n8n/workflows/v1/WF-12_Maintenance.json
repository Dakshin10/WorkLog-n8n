    {
      "parameters": {
        "jsCode": "const timesheetRows = $('Get Timesheet Rows (Digest)').all().map(i => i.json);\nconst employeeRows = $('Get Employees (Digest)').all().map(i => i.json);\n\nconst todayIso = new Date().toISOString().slice(0, 10);\nconst todaysRows = timesheetRows.filter(r => (r.Date || '').toString().slice(0, 10) === todayIso && (r.Status || 'LOGGED') !== 'SUPERSEDED');\n\nconst codesLoggedToday = new Set(todaysRows.map(r => (r['Employee Code'] || '').toString().trim().toUpperCase()));\nconst activeEmployees = employeeRows.filter(r => (r.Status || '').toString().trim().toUpperCase() === 'ACTIVE');\nconst missing = activeEmployees.filter(r => !codesLoggedToday.has((r['Employee Code'] || '').toString().trim().toUpperCase()));\n\nconst totalHoursToday = todaysRows.reduce((sum, r) => sum + (Number(r['Contributed Hours']) || 0), 0);\n\nconst lines = [\n  `WorkLog Lite daily digest \u2014 ${todayIso}`,\n  ``,\n  `Entries logged today: ${todaysRows.length} (${totalHoursToday} h total)`,\n  ``,\n  missing.length\n    ? `Active employees with no entry today (${missing.length}):`\n    : 'Every active employee logged an entry today.',\n  ...missing.map(r => `  - ${r['Employee Code']} (${r.Name || 'unknown'})`)\n];\n\nreturn [{ json: { digest_text: lines.join('\\n') } }];"
      },
      "id": "build_digest",
      "name": "Build HR Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        1190
      ]
    },
