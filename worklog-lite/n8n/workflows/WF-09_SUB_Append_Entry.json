        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "session_id": "={{ $('When Executed by Another Workflow').first().json.session_id }}",
            "employee_code": "={{ $('When Executed by Another Workflow').first().json.employee.code }}",
            "event": "SAVED",
            "detail": "={{ { entry_id: $('When Executed by Another Workflow').first().json.entry_id, hours: $('When Executed by Another Workflow').first().json.entry.hours, project: $('When Executed by Another Workflow').first().json.entry.project, activity: $('When Executed by Another Workflow').first().json.entry.activity } }}"
          }
        },
        "options": {}
      },
