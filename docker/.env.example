# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_change_me

# n8n Configuration
N8N_ENCRYPTION_KEY=super_secret_n8n_encryption_key_change_me
WEBHOOK_URL=https://worklog.example.com/
TZ=Asia/Kolkata

# Environment mode ('local' | 'production')
APP_ENV=local

# Azure Entra ID Credentials
APP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
APP_ENTRA_API_AUDIENCE=api://worklog-ai-api-id

# Microsoft Teams Bot Credentials
APP_BOT_APP_ID=00000000-0000-0000-0000-000000000000
APP_BOT_TENANT_ID=00000000-0000-0000-0000-000000000000
APP_BOT_CLIENT_SECRET=bot_client_secret_value

# Application Base Web URL
APP_WEB_BASE_URL=https://worklog.example.com
APP_DEFAULT_TZ=Asia/Kolkata

# Caddy Domain
DOMAIN_NAME=worklog.example.com
